{
  "version": 1,
  "enabled": false,
  "repository": "OWNER/REPOSITORY",
  "reviewers": [
    {"login": "copilot-pull-request-reviewer", "waitAfterPush": true}
  ],
  "ignoreReviewBodies": ["copilot-pull-request-reviewer"],
  "maxRounds": 3,
  "quietSeconds": 120,
  "waitSeconds": 600,
  "pollSeconds": 30,
  "actions": {"fix": false, "push": false, "reply": false, "resolve": false}
}
